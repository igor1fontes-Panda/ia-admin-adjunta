# npm connection resilience — permanent project-level settings.
# Applies to npm install/ci in every shell mode without env vars.
# The publishable Supabase config lives in src/lib/data.ts (public by design);
# no secrets belong in this file.
fund=false
audit=false
fetch-retries=5
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=60000
fetch-timeout=120000
registry=https://registry.npmjs.org/
prefer-offline=true
