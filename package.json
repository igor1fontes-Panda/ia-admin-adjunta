{
  "name": "fontes-ai-admin-adjunta",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:next": "next dev",
    "build": "vite build",
    "build:next": "next build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "audit:python": "python3 -m venv .venv-pip-audit && .venv-pip-audit/bin/python -m pip install -q -r requirements-dev.txt && .venv-pip-audit/bin/python -m pip_audit -r requirements.txt",
    "lint": "eslint src",
    "typecheck": "tsc -b --noEmit",
    "bot:leads": "node --env-file-if-exists=.env.local scripts/lead-hunter.mjs",
    "bot:error-handler": "node --env-file-if-exists=.env.local scripts/error-handler.mjs",
    "bot:growth": "node --env-file-if-exists=.env.local scripts/growth-marketing.mjs",
    "bot:teacher": "node --env-file-if-exists=.env.local scripts/teacher-agent.mjs",
    "bot:manager": "node --env-file-if-exists=.env.local scripts/ops-manager.mjs",
    "bot:skills": "node --env-file-if-exists=.env.local scripts/skills-scout.mjs",
    "db:neon:health": "node --env-file-if-exists=.env.local scripts/neon-health.mjs",
    "db:push": "drizzle-kit push",
    "db:smoke": "node scripts/db-smoke.mjs",
    "db:read-back": "node scripts/db-read-back.mjs",
    "preview:fullstack": "bun scripts/dev-server.mjs",
    "e2e": "bun scripts/e2e-gauntlet.mjs",
    "auth:smoke": "node --env-file-if-exists=.env.local scripts/auth-smoke.mjs",
    "bot:insight": "python3 ai_engine.py"
  },
  "overrides": {
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@clerk/backend": "^3.18.1",
    "@clerk/react": "^6.16.1",
    "@google/genai": "^2.23.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/server": "^1.7.0",
    "@supabase/supabase-js": "^2.45.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "postcss": "^8.4.40",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "stripe": "^22.6.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
