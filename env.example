# Copy this file to .env and fill in your values. Never commit the real .env.

# Required for live (production) mode — dashboard connects with these.
# Get them from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required for the autonomous bots (GitHub Actions + local runs).
# Get it from: https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# Bot runtime config (repo secrets in GitHub Actions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_BOT_MIN_SCORE=70
LEAD_BOT_MAX_PER_RUN=5
