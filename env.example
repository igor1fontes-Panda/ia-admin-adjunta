# Public browser configuration
# Set true for local development without the database-backed API
VITE_MOCK_DATA=false

# Server-only Supabase configuration (legacy bot fallback path)
SUPABASE_URL_2=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY_2=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional integrations
STRIPE_SECRET_KEY=
GEMINI_API_KEY=
BLACKBOX_API_KEY=
HUME_API_KEY=
SITE_URL=http://localhost:5173

# Neon Postgres (pooled connection string) — server-side only, never in the browser
DATABASE_URL=
NEON_DATABASE_URL=

# Better Auth (server-side session cookies)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Stripe webhook (order recording)
STRIPE_WEBHOOK_SECRET=
