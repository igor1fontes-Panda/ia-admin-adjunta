# Copy this file to .env and fill in your values. Never commit the real .env.

# Required — dashboard (browser) connects with these. Real data only, no demo mode.
# Get them from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — AI layer for the autonomous bots (free tier works).
# Get it from: https://aistudio.google.com → Get API key
# Bots use the Gemini Interactions API with model fallback:
# gemini-3.6-flash → gemini-3.8-flash → gemini-2.5-flash → gemini-2.0-flash
# Without a key, bots use deterministic rule-scoring on real data (never fabricate).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional — second AI provider (OpenAI-compatible, used as automatic fallback).
# Get it from: https://app.blackbox.ai (enterprise API)
BLACKBOX_API_KEY=
BLACKBOX_MODEL=nvidia/nemotron-3-ultra-550b-a55b
BLACKBOX_BASE_URL=https://enterprise.blackbox.ai/chat/completions

# Optional — expressive voice briefings (Hume AI TTS / Octave).
# Get it from: https://app.hume.ai/keys
# Flow: POST /v0/tts -> generation_id -> POST /v0/tts/voices ("David Hume")
# Audio briefings are stored in Supabase Storage bucket `briefings` (create it once).
HUME_API_KEY=
HUME_VOICE_NAME=David Hume
BRIEFING_BUCKET=briefings

# Required for bots (GitHub Actions secrets or local runs)
# service_role key — server-side ONLY, never expose in the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEAD_BOT_MIN_SCORE=70
