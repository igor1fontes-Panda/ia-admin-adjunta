# Copy this file to .env and fill in your values. Never commit the real .env.

# ---- Browser (dashboard) — public keys only, safe to expose ----
# Required for real data mode. Get them from: Supabase Dashboard → Project Settings → API
# New projects use sb_publishable_... keys; legacy projects use a JWT anon key.
# Both work — whichever your project shows, paste it in VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set true for local development without Supabase (mock data)
VITE_MOCK_DATA=false

# ---- Server-side Supabase — bots, Edge Functions, ai_engine.py. NEVER in the browser. ----
# New projects use sb_secret_... keys; legacy use the service_role JWT.
# Either works — whichever your project shows, paste it in SUPABASE_SECRET_KEY
# (or SUPABASE_SERVICE_ROLE_KEY — both are accepted everywhere).
# SUPABASE_URL_2 lets you point the bots at a second project (overrides SUPABASE_URL).
SUPABASE_URL=
SUPABASE_URL_2=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# ---- AI layer for the autonomous bots (optional, free tier works) ----
# Get it from: https://aistudio.google.com → Get API key
# Bots use the Gemini Interactions API with model fallback:
# gemini-3.6-flash → gemini-3.8-flash → gemini-2.5-flash → gemini-2.0-flash
# Without a key, bots use deterministic rule-scoring on real data (never fabricate).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Second AI provider (OpenAI-compatible, used as automatic fallback).
# Get it from: https://app.blackbox.ai (enterprise API)
BLACKBOX_API_KEY=
BLACKBOX_MODEL=nvidia/nemotron-3-ultra-550b-a55b
BLACKBOX_BASE_URL=https://enterprise.blackbox.ai/chat/completions

# Expressive voice briefings (Hume AI TTS / Octave). Flow: POST /v0/tts ->
# generation_id -> POST /v0/tts/voices ("David Hume"). Audio briefings are
# stored in Supabase Storage bucket `briefings` (create it once).
HUME_API_KEY=
HUME_VOICE_NAME=David Hume
BRIEFING_BUCKET=briefings

# ---- Payments (real Stripe checkout + webhook fulfillment) ----
# Keep all STRIPE_* secrets server-side; never prefix them with VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# ---- Misc ----
# Public site URL (health checks, lead links)
PUBLIC_SITE_URL=
SITE_URL=http://localhost:5173
# Bot tuning
LEAD_BOT_MIN_SCORE=70
# Neon readiness checks (scripts/neon-health.mjs)
DATABASE_URL=
NEON_DATABASE_URL=
