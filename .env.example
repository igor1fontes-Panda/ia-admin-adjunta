# Public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Set true for local development without Supabase
VITE_MOCK_DATA=false

# Server-only Supabase configuration
SUPABASE_URL_2=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY_2=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional integrations
STRIPE_SECRET_KEY=
GEMINI_API_KEY=
BLACKBOX_API_KEY=
HUME_API_KEY=
SITE_URL=http://localhost:5173

# Auth and server runtime
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
AUTH_SMOKE_PASSWORD=
AUTH_SMOKE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:5173
STRIPE_WEBHOOK_SECRET=

# AI and bot runtime
GEMINI_MODEL=gemini-2.5-flash
BLACKBOX_BASE_URL=https://enterprise.blackbox.ai/chat/completions
BLACKBOX_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Neon readiness checks
DATABASE_URL=
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
