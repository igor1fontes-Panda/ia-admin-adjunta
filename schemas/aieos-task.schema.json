{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ia-admin-adjunta.com/schemas/aieos-task.schema.json",
  "title": "AIEOS Task Contract",
  "description": "Provider-neutral, auditable task envelope for bounded-autonomy AI engineering workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "title",
    "objective",
    "status",
    "risk",
    "autonomy",
    "acceptance_criteria",
    "permissions",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "task_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]+$" },
    "project_id": { "type": "string", "minLength": 2, "maxLength": 128 },
    "title": { "type": "string", "minLength": 3, "maxLength": 180 },
    "objective": { "type": "string", "minLength": 10, "maxLength": 10000 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 100 },
        "out": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 100 },
        "constraints": { "type": "array", "items": { "type": "string", "maxLength": 1000 }, "maxItems": 100 }
      }
    },
    "status": {
      "enum": ["proposed", "triaged", "ready", "assigned", "running", "review", "validating", "approved", "released", "monitored", "closed", "blocked", "failed", "cancelled"]
    },
    "priority": { "enum": ["low", "normal", "high", "urgent"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "autonomy": { "enum": ["read_only", "bounded"], "description": "Bounded permits only task-scoped reversible work on an authorised branch; protected actions remain approval-gated." },
    "assigned_agent": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "agent_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 2, "maxLength": 80 },
        "agent_id": { "type": "string", "minLength": 2, "maxLength": 120 },
        "model": { "type": "string", "maxLength": 120 },
        "connection_mode": { "enum": ["api", "mcp", "cli", "manual"] }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "type": "string", "minLength": 3, "maxLength": 1000 }
    },
    "dependencies": { "type": "array", "items": { "type": "string", "maxLength": 128 }, "maxItems": 100 },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "external_side_effects", "production"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 100 },
        "write": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 100 },
        "external_side_effects": { "type": "boolean" },
        "production": { "type": "boolean", "const": false }
      }
    },
    "approvals_required": {
      "type": "array",
      "items": { "enum": ["human_owner", "independent_reviewer", "security_reviewer", "release_manager"] },
      "uniqueItems": true
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "decision", "actor", "timestamp"],
        "properties": {
          "role": { "type": "string", "maxLength": 80 },
          "decision": { "enum": ["approved", "rejected", "changes_requested"] },
          "actor": { "type": "string", "maxLength": 160 },
          "timestamp": { "type": "string", "format": "date-time" },
          "evidence_uri": { "type": "string", "format": "uri" }
        }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string", "format": "uri" }, "maxItems": 100 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "result", "captured_at"],
        "properties": {
          "kind": { "enum": ["diff", "test", "build", "security_scan", "review", "deployment", "manual"] },
          "result": { "enum": ["pass", "fail", "not_run", "blocked"] },
          "summary": { "type": "string", "maxLength": 2000 },
          "uri": { "type": "string", "format": "uri" },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      },
      "maxItems": 200
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "due_at": { "type": "string", "format": "date-time" },
    "blocked_reason": { "type": "string", "maxLength": 2000 },
    "result_summary": { "type": "string", "maxLength": 5000 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "permissions": {
            "properties": { "external_side_effects": { "const": true } },
            "required": ["external_side_effects"]
          }
        },
        "required": ["permissions"]
      },
      "then": {
        "required": ["approvals_required"],
        "properties": {
          "approvals_required": { "contains": { "const": "human_owner" } }
        }
      }
    }
  ]
}